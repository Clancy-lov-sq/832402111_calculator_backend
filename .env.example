# ---------------------------------------------------------------------------
# Calculator backend - example environment configuration
# Copy this file to `.env` (or export the variables) and edit as needed.
# Every variable below is optional: the defaults in src/config/config.js are
# used when a variable is missing.
# ---------------------------------------------------------------------------

# --- HTTP server -----------------------------------------------------------
PORT=8080
HOST=0.0.0.0

# Comma separated list of allowed CORS origins. Use * to allow every origin.
# Keep the explicit list in production and allow the origin of the deployed
# front end only.
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

# "strict"  -> rejected expressions also use HTTP 400 (REST-like)
# "lenient" -> rejected expressions answer HTTP 200 with success=false, which
#              matches the simple response format shown in the assignment.
ERROR_HTTP_MODE=lenient

# --- Database --------------------------------------------------------------
# sqlite (default, no external service needed) or mysql
DB_CLIENT=sqlite
# SQLite file path, relative to the back-end repository root
SQLITE_PATH=data/calculator.db

# MySQL settings, only used when DB_CLIENT=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=calculator

# --- Expression engine limits ---------------------------------------------
MAX_EXPRESSION_LENGTH=200
MAX_TOKEN_COUNT=256
MAX_NESTING_DEPTH=32
